# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Tavily API Configuration for Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Execution Limits
MAX_AGENT_STEPS=6

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Optional SQLite Database Path override
# Local default: data/history.db | Vercel default: /tmp/data/history.db
# SQLITE_DB_PATH=data/history.db

# Note for Vercel Deployment:
# Configure GEMINI_API_KEY and TAVILY_API_KEY in the Vercel Project Settings > Environment Variables.
# Do NOT upload real API keys to GitHub.
